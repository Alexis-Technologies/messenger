{
  "name": "@alexify/messenger",
  "version": "0.0.1",
  "description": "Zero-dependency messaging for Node.js, Bun and Deno: SMS, RCS, WhatsApp, Messenger, Instagram, Telegram, Viber, Slack, Discord, Microsoft Teams, Google Chat and push through their HTTP APIs, with a reliability layer on top — a persistent queue, an audit of message states, one model of delivery receipts from verified webhooks, idempotency and fallback between providers and channels",
  "license": "MIT",
  "type": "commonjs",
  "author": "Alex Dolid <dolid.sasha@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Alexis-Technologies/messenger.git"
  },
  "homepage": "https://messengerat.vercel.app/",
  "bugs": {
    "url": "https://github.com/Alexis-Technologies/messenger/issues"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "pnpm@10.34.5",
  "main": "index.js",
  "types": "index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    }
  },
  "directories": {
    "test": "tests"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "src",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "SECURITY.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "node --test tests/unit/*.test.js",
    "test:runtime": "node --test tests/runtime/*.test.js",
    "test:bun": "bun test --parallel --timeout 30000 tests/unit tests/runtime",
    "test:deno": "deno test -A --no-check --parallel tests/unit/ tests/runtime/",
    "test:coverage": "c8 --all --include 'src/**' --check-coverage --lines 98 --statements 98 --branches 90 --functions 100 --reporter text --reporter lcov node --test tests/unit/*.test.js",
    "test:types": "tsd",
    "check:dts": "node scripts/check-dts.js",
    "check:pack": "node scripts/check-pack.js",
    "lint": "oxlint --report-unused-disable-directives-severity=error src tests scripts bench",
    "format": "oxfmt src tests scripts bench",
    "format:check": "oxfmt --check src tests scripts bench",
    "size": "node scripts/size.js",
    "bench": "node bench/bench.js",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "docs:comparison": "node scripts/comparison.js",
    "prepublishOnly": "pnpm run lint && pnpm run format:check && pnpm run test:coverage && pnpm run test:runtime && pnpm run test:types && pnpm run check:dts && pnpm size --check && pnpm run check:pack",
    "release": "pnpm publish"
  },
  "tsd": {
    "directory": "tests/types"
  },
  "keywords": [
    "messenger",
    "messaging",
    "notifications",
    "omnichannel",
    "multichannel",
    "sms",
    "rcs",
    "whatsapp",
    "whatsapp-cloud-api",
    "facebook-messenger",
    "instagram",
    "telegram",
    "telegram-bot-api",
    "viber",
    "slack",
    "discord",
    "microsoft-teams",
    "google-chat",
    "push-notifications",
    "fcm",
    "apns",
    "web-push",
    "otp",
    "twilio-alternative",
    "delivery-receipts",
    "webhooks",
    "fallback",
    "outbox",
    "audit-log",
    "idempotency",
    "opt-out",
    "e164",
    "zero-dependency",
    "bun",
    "deno"
  ],
  "devDependencies": {
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "c8": "^12.0.0",
    "esbuild": "^0.28.2",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.75.0",
    "tsd": "^0.33.0",
    "typescript": "^7.0.2",
    "vitepress": "^1.6.4"
  }
}
